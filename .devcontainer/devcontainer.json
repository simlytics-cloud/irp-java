{
  "name": "IRP Tutorial (Java 21 + Maven 3.9)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven"
      ],
      "settings": {
        "maven.terminal.useJavaHome": true
      }
    }
  }
}


